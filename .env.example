# CHICKTRADE Live & Paper Trading Bot Configuration
# Copy this file to .env and adjust values before running.

# Execution Mode: PAPER | TESTNET | LIVE
EXECUTION_MODE=PAPER

# Safety Buffer in Units: 250 (->2), 300 (->3), 400 (->5), 500 (->7)
BUFFER_UNITS=400
# Optional override for max concurrent trades (leave empty to auto-map from BUFFER_UNITS)
MAX_CONCURRENT_TRADES=

# Auto-Turbo Mode (default OFF):
# When true: shifts 400G -> 230G when equity >= 1.25x initial capital,
# disengages < 1.15x, and ALWAYS enforces hard worst-case SL sweep floor:
# Current_Equity - Total_Open_And_New_SL_Risk_USD >= Initial_Capital * 1.10
# (auto-falls back to 400G if violated).
AUTO_TURBO_ENABLED=false
AUTO_TURBO_BUFFER_UNITS=230

# Capital & Daily Risk Limits
INITIAL_CAPITAL=10000
MAX_TRADES_PER_DAY=10
POLL_INTERVAL_SECONDS=30

# Optional Telegram Notifications (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance USD-M Futures API Credentials (required for TESTNET / LIVE)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safety Guard: Must be set to true to allow real orders in LIVE mode
LIVE_CONFIRMED=false
